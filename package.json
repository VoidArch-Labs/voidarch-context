{
  "name": "@voidarch/context",
  "version": "0.1.0",
  "type": "module",
  "description": "Voidarch Context \u2014 drop-in local repo memory, query, and context-pack engine for AI coding agents. Local embeddings, embedded DB, no API key required.",
  "license": "MIT",
  "bin": {
    "voidarch-context": "./bin/voidarch-context.js"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "schema",
    "page",
    "docs",
    "README.md"
  ],
  "exports": {
    "./agents": "./src/agents.ts",
    "./batch": "./src/batch.ts",
    "./cli": "./src/cli.ts",
    "./context-pack": "./src/context-pack.ts",
    "./docs": "./src/docs.ts",
    "./graph": "./src/graph.ts",
    "./graph-build": "./src/graph-build.ts",
    "./ingest": "./src/ingest.ts",
    "./metrics": "./src/metrics.ts",
    "./voidarch-config": "./src/voidarch-config.ts",
    "./runs": "./src/runs.ts",
    "./scoring": "./src/scoring.ts",
    "./surreal": "./src/surreal.ts",
    "./types": "./src/types.ts",
    "./vectors": "./src/vectors.ts",
    "./delegation": "./src/delegation.ts",
    "./general": "./src/general.ts",
    "./write-policy": "./src/write-policy.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "bash scripts/ci-smoke.sh",
    "test:general": "tsx --test --test-force-exit tests/general-plane.test.ts tests/context-compiler.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@surrealdb/node": "^3.0.3",
    "surrealdb": "^2.0.4",
    "tree-sitter-wasms": "^0.1.13",
    "tsx": "^4.22.4",
    "web-tree-sitter": "^0.24.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoidArch-Labs/voidarch-context.git"
  },
  "homepage": "https://github.com/VoidArch-Labs/voidarch-context#readme",
  "bugs": {
    "url": "https://github.com/VoidArch-Labs/voidarch-context/issues"
  },
  "keywords": [
    "voidarch",
    "context",
    "memory",
    "ai-agents",
    "claude-code",
    "codex",
    "context-pack",
    "local-first",
    "embeddings",
    "surrealdb",
    "tree-sitter"
  ]
}
